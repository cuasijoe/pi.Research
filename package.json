{
  "name": "pi.Research",
  "version": "0.1.0",
  "description": "Web research subagent for pi coding agent",
  "private": true,
  "type": "module",
  "main": "./src/index.ts",
  "keywords": ["pi-package", "pi-extension", "research"],
  "files": ["src", "README.md"],
  "pi": {
    "extensions": ["./src/index.ts"]
  },
  "scripts": {
    "check": "tsc --noEmit && prettier --check .",
    "test": "node --test --import=tsx 'test/**/*.test.ts' --exclude='test/integration/**'",
    "test:integration": "PI_RESEARCH_INTEGRATION=1 node --test --import=tsx 'test/integration/**/*.test.ts'",
    "test:all": "npm test && npm run test:integration",
    "build": "npm run check && npm run test && npm pack"
  },
  "dependencies": {
    "@mozilla/readability": "^0.5.0",
    "turndown": "^7.1.3",
    "jsdom": "^24.0.0"
  },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "latest",
    "@earendil-works/pi-tui": "latest",
    "@types/node": "^20.0.0",
    "@types/jsdom": "^21.1.6",
    "@types/turndown": "^5.0.4",
    "prettier": "^3.0.0",
    "tsx": "^4.0.0",
    "typescript": "^5.0.0"
  }
}
